      #|  b32[3 * 4 + 1] = 0x6b206574
      #|  b32[3 * 4 + 2] = 0x6b206574
      #|  b32[3 * 4 + 3] = 0x6b206574
      #|  b32[4 * 4 + 0] = seed[0]
      #|  b32[4 * 4 + 1] = seed[0]
      #|  b32[4 * 4 + 2] = seed[0]
      #|  b32[4 * 4 + 3] = seed[0]
      #|  b32[5 * 4 + 0] = seed[1]
      #|  b32[5 * 4 + 1] = seed[1]
      #|  b32[5 * 4 + 2] = seed[1]
      #|  b32[5 * 4 + 3] = seed[1]
      #|  b32[6 * 4 + 0] = seed[2]
      #|  b32[6 * 4 + 1] = seed[2]
      #|  b32[6 * 4 + 2] = seed[2]
      #|  b32[6 * 4 + 3] = seed[2]
      #|  b32[7 * 4 + 0] = seed[3]
      #|  b32[7 * 4 + 1] = seed[3]
      #|  b32[7 * 4 + 2] = seed[3]
      #|  b32[7 * 4 + 3] = seed[3]
      #|  b32[8 * 4 + 0] = seed[4]
      #|  b32[8 * 4 + 1] = seed[4]
      #|  b32[8 * 4 + 2] = seed[4]
