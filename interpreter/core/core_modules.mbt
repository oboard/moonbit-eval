      #|          let v = val.no_wrap()
      #|          match v.lines {
      #|            [] => empty_content()
      #|            [one] =>
      #|              no_parens(
      #|                content_parens(1 + k.size + v.size, [
      #|                  print_content(surround("", ": ", k)) + one,
      #|                ]),
      #|              )
      #|            [first, .. rest] => {
      #|              let head = print_content(surround("", ": ", k)) + first
      #|              no_parens(content_parens(1 + k.size + v.size, [head, ..rest]))
      #|            }
      #|          }
      #|        }
      #|        _ => empty_content()
      #|      }
      #|    EnumLabeledArg(name, _) =>
