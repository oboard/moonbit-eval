      #|  let hi = self.buffer[index * 2 + 1].to_uint64()
      #|  (hi << 32) | lo
      #|}
      #|pub fn ChaCha8::refill(self : ChaCha8) -> Unit {
      #|  self.counter += COUNTER_INC
      #|  if self.counter == COUNTER_MAX {
