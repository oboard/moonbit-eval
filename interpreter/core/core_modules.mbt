      #|  z = u + v
      #|  w = v - (z - u)
      #|  t = z * z
      #|  t1 = z - t * (p1 + t * (p2 + t * (p3 + t * (p4 + t * p5))))
      #|  r = z * t1 / (t1 - 2.0) - (w + z * w)
      #|  z = (1.0 : Float) - (r - z)
      #|  j = z.reinterpret_as_int()
      #|  j += n << 23
      #|  if j >> 23 <= 0 {
      #|    z = scalbnf(z, n)
      #|  } else {
      #|    z = Float::reinterpret_from_int(j)
      #|  }
      #|  sn * z
      #|}
    ),
    "pow_double_js.mbt": (
      #|pub fn pow(base : Double, exponent : Double) -> Double {
      #|  if base == 1.0 {
