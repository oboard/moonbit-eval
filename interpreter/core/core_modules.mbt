    "iter.mbt": (
      #|pub fn Int::until(
      #|  self : Int,
      #|  end : Int,
      #|  step? : Int = 1,
      #|  inclusive? : Bool = false,
      #|) -> Iter[Int] {
      #|  until_impl(self, end, step, inclusive)
      #|}
