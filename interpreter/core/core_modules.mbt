      #|      b11 = tb4_2
      #|      b15 = tb4_3
      #|      let Quadruple(tb5_0, tb5_1, tb5_2, tb5_3) = qr(
      #|        Quadruple(b0, b5, b10, b15),
      #|      )
      #|      b0 = tb5_0
      #|      b5 = tb5_1
      #|      b10 = tb5_2
      #|      b15 = tb5_3
      #|      let Quadruple(tb6_0, tb6_1, tb6_2, tb6_3) = qr(
      #|        Quadruple(b1, b6, b11, b12),
