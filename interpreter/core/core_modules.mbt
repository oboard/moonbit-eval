    "range.mbt": (
      #|fn[T : Add + Compare + Default] until_impl(
      #|  start : T,
      #|  end : T,
      #|  step : T,
      #|  inclusive : Bool,
      #|) -> Iter[T] {
      #|  let zero = Default::default()
      #|  if step == zero {
      #|    return [||]
      #|  }
      #|  let mut i = start
      #|  let mut done = false
      #|  Iter::new(() => {
      #|    guard !done else { None }
      #|    guard (step > zero && i < end) ||
      #|      (step < zero && i > end) ||
      #|      (inclusive && i == end) else {
      #|      None
      #|    }
      #|    let value = i
      #|    let next = i + step
      #|    if (step > zero && next >= i) || (step < zero && next <= i) {
      #|      i = next
      #|    } else {
      #|      done = true
      #|    }
      #|    Some(value)
      #|  })
      #|}
    ),
