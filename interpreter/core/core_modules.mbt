      #|    let d = (d << 16) | (d >> 16)
      #|    let c = c + d
      #|    let b = b ^ c
      #|    let b = (b << 12) | (b >> 20)
      #|    let a = a + b
      #|    let d = d ^ a
      #|    let d = (d << 8) | (d >> 24)
      #|    let c = c + d
      #|    let b = b ^ c
