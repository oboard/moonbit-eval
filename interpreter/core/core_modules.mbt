      #|}
      #|const COUNTER_INC = 4U
      #|const COUNTER_MAX = 16U
      #|const BUFFER_CHUNK_NUM = 32
      #|const SEED_CHUNK_NUM = 4
      #|pub fn ChaCha8::next_uint64(self : ChaCha8) -> UInt64 {
