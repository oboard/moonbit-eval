      #|  b32[1 * 4 + 1] = 0x3320646e
      #|  b32[1 * 4 + 2] = 0x3320646e
      #|  b32[1 * 4 + 3] = 0x3320646e
      #|  b32[2 * 4 + 0] = 0x79622d32
      #|  b32[2 * 4 + 1] = 0x79622d32
