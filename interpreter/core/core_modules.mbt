      #|}
      #|extern "js" fn get_env_vars_array_internal() -> FixedArray[String] =
      #|  #| function() {
      #|  #|   if (typeof process === "undefined" || typeof process.env === "undefined") {
      #|  #|     return [];
      #|  #|   }
