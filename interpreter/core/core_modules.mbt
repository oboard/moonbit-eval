      #|        }
      #|      }
      #|      _ => {
      #|        let out : Array[String] = [begin]
      #|        for item in contents {
      #|          let item_lines = item.filter(line => line != "")
      #|          match item_lines {
      #|            [] => ()
      #|            [x] => out.push(" ".repeat(indent_by) + x + ",")
      #|            [first, .. middle, last] => {
      #|              out.push(" ".repeat(indent_by) + first)
      #|              for mid in middle {
