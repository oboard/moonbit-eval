      #|    let i = for i = i; i < self.length() && !pred(self[i]); {
      #|      chunk.push(self[i])
      #|      continue i + 1
      #|    } nobreak {
      #|      i
      #|    }
      #|    chunks.push(chunk)
      #|    continue i + 1
      #|  }
      #|  chunks
      #|}
      #|#alias(iterator, deprecated)
      #|pub fn[T] Array::iter(self : Array[T]) -> Iter[T] {
      #|  self[:].iter()
      #|}
      #|#alias(rev_iterator, deprecated)
      #|pub fn[T] Array::rev_iter(self : Array[T]) -> Iter[T] {
