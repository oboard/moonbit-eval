      #|) -> Array[String] {
      #|  match lines {
      #|    [] => [start + finish]
      #|    [item] => [start + item + finish]
      #|    [first, .. middle, last] => [start + first, ..middle, last + finish]
      #|  }
      #|}
      #|fn surround(
      #|  start : String,
      #|  finish : String,
      #|  r : ContentParens,
