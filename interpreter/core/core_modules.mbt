      #|  self.unsafe_truncate_to_length(len)
      #|}
      #|#locals(f)
      #|pub fn[A] Array::retain_map(
      #|  self : Array[A],
      #|  f : (A) -> A? raise?,
      #|) -> Unit raise? {
      #|  if self.is_empty() {
