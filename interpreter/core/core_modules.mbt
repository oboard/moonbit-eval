      #|      data[i * 4] = (c & 0xFF).to_byte()
      #|      data[i * 4 + 1] = ((c >> 8) & 0xFF).to_byte()
      #|      data[i * 4 + 2] = 0
      #|      data[i * 4 + 3] = 0
