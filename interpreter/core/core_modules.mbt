      #|  let magnitude = if x < zero { -x } else { x }
      #|  let bit_length = magnitude.bit_length()
      #|  let negative = x < zero
      #|  let mut shift = bit_length - 1
      #|  let mut emit_zero = true
      #|  Iter::new(
      #|    () => {
