      #|pub fn[T] ReadOnlyArray::all(
      #|  self : ReadOnlyArray[T],
      #|  f : (T) -> Bool raise?,
      #|) -> Bool raise? {
      #|  self.unsafe_reinterpret_to_fixed_array().all(f)
      #|}
      #|#alias(exists)
      #|pub fn[T] ReadOnlyArray::any(
      #|  self : ReadOnlyArray[T],
      #|  f : (T) -> Bool raise?,
