      #|pub fn ChaCha8::ChaCha8(seed : BytesView) -> ChaCha8 {
      #|  if seed.length() != 32 {
      #|    abort("seed must be 32 bytes long")
      #|  }
      #|  let seed = FixedArray::makei(SEED_CHUNK_NUM * 2, i => {
      #|    match seed[i * 4:] {
