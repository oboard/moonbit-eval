      #|    let val = buf[read_idx]
      #|    match f(val) {
      #|      Some(new_val) => {
      #|        buf[write_idx] = new_val
      #|        continue write_idx + 1
      #|      }
      #|      None => continue write_idx
      #|    }
      #|  } nobreak {
      #|    self.unsafe_truncate_to_length(write_idx)
      #|  }
      #|}
      #|#alias(from_iterator, deprecated)
      #|pub fn[T] Array::from_iter(iter : Iter[T]) -> Array[T] {
