      #|          middle_lines.append(surround_lines(space, ",", item))
      #|        }
      #|        [
      #|          ..surround_lines(begin, ",", first),
      #|          ..middle_lines,
      #|          ..surround_lines(space, end, last),
      #|        ]
      #|      }
      #|    }
      #|    lines.filter(line => line != "")
      #|  } else {
      #|    let indent_by = 2
      #|    match contents {
      #|      [] => [begin + end]
