      #|  #| function(key) {
      #|  #|   if (typeof process !== "undefined" && typeof process.env !== "undefined") {
      #|  #|     delete process.env[key];
      #|  #|   }
      #|  #| }
      #|fn rand_internal(to_be_filled : FixedArray[Byte]) -> Bool {
      #|  if to_be_filled.length() == 0 {
      #|    return true
      #|  }
      #|  get_random_values_js(to_be_filled)
