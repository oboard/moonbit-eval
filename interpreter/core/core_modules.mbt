      #|pub fn[A : Arbitrary + @shrink.Shrink] report(
      #|  property : (A) -> Bool raise?,
      #|  filter? : (A) -> Bool = _ => true,
      #|  observe? : (A) -> Observations = _ => [],
      #|  counterexample_context? : (A) -> String,
