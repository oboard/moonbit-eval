      #|}
      #|extern "js" fn set_env_var_ffi(key : String, value : String) -> Unit =
      #|  #| function(key, value) {
      #|  #|   if (typeof process !== "undefined" && typeof process.env !== "undefined") {
      #|  #|     process.env[key] = value;
