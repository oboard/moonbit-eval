      #|    },
      #|    'A',
      #|    'B',
      #|    'C',
      #|    '1',
      #|    '2',
      #|    '3',
      #|    ' ',
      #|    '\n',
      #|  ]
      #|  candidates.sort()
      #|  candidates.dedup()
      #|  let char_stamp = (c : Char) => {
      #|    (
      #|      (!c.is_ascii_lowercase(), !c.is_ascii_uppercase(), !c.is_ascii_digit()),
      #|      (c != ' ', !c.is_whitespace(), c),
      #|    )
      #|  }
      #|  let stamp = char_stamp(c)
