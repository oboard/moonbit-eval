      #|      b3 = tb8_0
      #|      b4 = tb8_1
      #|      b9 = tb8_2
      #|      b14 = tb8_3
      #|    }
      #|    buf[0 * 4 + i] = b0
      #|    buf[1 * 4 + i] = b1
      #|    buf[2 * 4 + i] = b2
      #|    buf[3 * 4 + i] = b3
      #|    buf[4 * 4 + i] += b4
      #|    buf[5 * 4 + i] += b5
      #|    buf[6 * 4 + i] += b6
      #|    buf[7 * 4 + i] += b7
      #|    buf[8 * 4 + i] += b8
      #|    buf[9 * 4 + i] += b9
      #|    buf[10 * 4 + i] += b10
      #|    buf[11 * 4 + i] += b11
      #|    buf[12 * 4 + i] = b12
      #|    buf[13 * 4 + i] = b13
      #|    buf[14 * 4 + i] = b14
      #|    buf[15 * 4 + i] = b15
      #|  }
      #|}
      #|fn setup(
      #|  seed : FixedArray[UInt],
      #|  b32 : FixedArray[UInt],
      #|  counter : UInt,
      #|) -> Unit {
      #|  b32[0 * 4 + 0] = 0x61707865
      #|  b32[0 * 4 + 1] = 0x61707865
      #|  b32[0 * 4 + 2] = 0x61707865
      #|  b32[0 * 4 + 3] = 0x61707865
