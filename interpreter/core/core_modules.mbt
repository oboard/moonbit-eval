      #|        shift -= 1
      #|        Some(if negative { x + delta } else { x - delta })
      #|      } else if emit_zero {
      #|        emit_zero = false
      #|        Some(zero)
      #|      } else {
      #|        None
      #|      }
      #|    },
      #|    size_hint=bit_length,
      #|  )
      #|}
      #|pub impl Shrink for UInt with fn shrink(x) {
