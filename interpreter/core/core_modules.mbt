      #|      b8 = tb1_2
      #|      b12 = tb1_3
      #|      let Quadruple(tb2_0, tb2_1, tb2_2, tb2_3) = qr(Quadruple(b1, b5, b9, b13))
      #|      b1 = tb2_0
      #|      b5 = tb2_1
      #|      b9 = tb2_2
      #|      b13 = tb2_3
      #|      let Quadruple(tb3_0, tb3_1, tb3_2, tb3_3) = qr(
