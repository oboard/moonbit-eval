      #|fn[T] removes_array(k : Int, n : Int, xs : Array[T]) -> Iter[Array[T]] {
      #|  guard k <= n else { [||] }
      #|  let mut start = 0
      #|  Iter::new(
      #|    fn() {
      #|      guard start + k <= n else { None }
      #|      let candidate = [..xs[:start], ..xs[start + k:]]
