      #|        Node(l=Empty, lo~, hi~, r~, ..) => {
      #|          node = r
      #|          break Some((lo, hi))
      #|        }
      #|        Node(l~, lo~, hi~, r~, ..) => {
      #|          parents.push((lo, hi, r))
      #|          continue l
      #|        }
      #|        Empty if parents.pop() is Some((lo, hi, r)) => {
      #|          node = r
      #|          break Some((lo, hi))
      #|        }
      #|        Empty => break None
      #|      }
      #|    }
      #|  })
      #|}
      #|pub fn RecharSet::from_sorted_array(
      #|  arr : ArrayView[(Rechar, Rechar)],
      #|) -> RecharSet {
      #|  RecharSet(build(arr, 0, arr.length() - 1))
      #|}
